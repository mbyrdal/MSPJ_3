<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/styles.css" />
</head>
<body>
    <header>
        <img src="~/resources/images/Remove background project.png" alt="Huggerriget Logo" class="logo"> <!-- LOGO location -->
        <h1>HUGGERRIGET</h1>
        <p>I HYGGER, Palle HUGGER</p>
        <div class="top-links">
            <a href="#">DNK / DK / DKK</a>
            <a href="#">Log ind</a>
        </div>
    </header>

    <main class="container">

        <!-- Sidebar Section -->
        

        <!-- Main Content Area with Search and Lager Sections -->
        <div class="content-area">
            <!-- Main Search Section -->
            <section class="login-section">
                <h2>Lav Din Bruger</h2>
                <form id="email-field">
                    <input type="email" name="emailField" placeholder="Skriv din E-mail" id="emailLogin" />
                </form>
                <form id="password-field">
                    <input type="password" name="passwordField" placeholder="Skriv dit password" id="passwordLogin" />
                </form>
                <form id="create-account-button">
                    <button type="submit">Lav Bruger</button>
                </form>
            </section>

            <!-- Lager List Section -->
            
        </div>
    </main>

    <script src="~/js/script.js"></script>
</body>
</html>


