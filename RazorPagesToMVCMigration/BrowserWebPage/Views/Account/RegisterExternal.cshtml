@model BrowserWebPage.Models.RegisterExternalViewModel

<h2>Register with Google</h2>

<form asp-action="RegisterExternal" method="post">
    <div class="form-group">
        <label for="Email">Email</label>
        <input type="email" id="Email" name="Email" class="form-control" value="@Model.Email" readonly />
    </div>

    <!-- You can add more fields here, like Name or Password if needed -->

    <button type="submit" class="btn btn-primary">Register</button>
</form>
