@model ServiceAPI.DTOs.LoginViewModel

@{
    ViewData["Title"] = "Stakeholder login";
}

<h2>Login</h2>

<div>
    <form method="post" asp-action="Login">
        <div>
            <label asp-for="Username"></label>
            <input asp-for="Username" />
        </div>
        <div>
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" />
        </div>
        <button type="submit">Login</button>
    </form>
</div>

<hr />

<h3>Or login using an external provider:</h3>
<div>
    <a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="OAuth2Provider">
        <button type="button">Login with OAuth2 Provider</button>
    </a>
</div>
