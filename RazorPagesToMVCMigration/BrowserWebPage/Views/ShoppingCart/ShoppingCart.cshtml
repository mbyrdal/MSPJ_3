@model ServiceAPI.Models.ShoppingCart

<h1>Shopping Cart</h1>

@if (Model.Items.Any())
{
    <table>
        <thead>
            <tr>
                <th>Product</th>
                <th>OEM</th>
                <th>Price</th>
                <th>Condition</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.CarPartID</td>
                    <td>@item.OEM</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.Condition</td>
                    <td>@item.ItemDescription</td>
                    <td>
                        <form method="post" asp-action="RemoveFromCart" asp-route-productId="@item.ID">
                            <button type="submit" class="btn btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <h2>Total: @Model.TotalPrice.ToString("C")</h2>

    <form method="post" asp-action="ClearCart">
        <button type="submit" class="btn btn-secondary">Clear Cart</button>
    </form>

    <form method="post" asp-action="CheckOut">
        <button type="submit" class="btn btn-primary">Check Out</button>
    </form>
}
else
{
    <p>Your cart is empty!</p>
}
