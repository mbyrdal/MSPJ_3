@model ClientWeb.Models.ShoppingCart

<h2>Din indkøbskurv</h2>

@if (Model.Items != null && Model.Items.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Pris</th>
                <th>Beskrivelse</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Price.ToString("C", new System.Globalization.CultureInfo("da-DK"))</td>
                    <td>@item.ItemDescription</td>
                    <td>
                        <form method="post" action="@Url.Action("RemoveFromCart", "ShoppingCart", new { OEM = item.OEM })">
                            <button type="submit">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Samlet pris: @Model.TotalPrice.ToString("C", new System.Globalization.CultureInfo("da-DK"))</h3>
    <form method="post" action="@Url.Action("CheckOut", "ShoppingCart")">
        <button type="submit">Fortsæt til Checkout</button>
    </form>
}
else
{
    <p>Din kurv er tom.</p>
}
