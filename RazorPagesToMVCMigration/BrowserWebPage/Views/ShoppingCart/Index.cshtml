@model ServiceAPI.Models.ShoppingCart

<h2>Your Shopping Cart</h2>

@if (Model.Items != null && Model.Items.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.OEM</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.Condition</td>
                    <td>@item.ItemDescription</td>
                    <td>
                        <form method="post" action="@Url.Action("RemoveFromCart", "ShoppingCart", new { productID = item.ID })">
                            <button type="submit">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Total Price: @Model.TotalPrice</h3>
    <form method="post" action="@Url.Action("CheckOut", "ShoppingCart")">
        <button type="submit">Proceed to Checkout</button>
    </form>
}
else
{
    <p>Your cart is empty.</p>
}
