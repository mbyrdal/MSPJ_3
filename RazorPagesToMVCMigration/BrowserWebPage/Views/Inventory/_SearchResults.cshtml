@using ServiceAPI.DatabaseAccess
@model List<ServiceAPI.Models.Product>

<table>
    <thead>
        <tr>
            <th>Navn</th>
            <th>OEM</th>
            <th>Price</th>
            <th>Tilstand</th>
            <th>Beskrivelse</th>
            <th>Tilgængelig</th> <!-- Add this column for the Add to Cart button -->
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            //DbCarPart carPart = new DbCarPart;
            foreach (var product in Model)
            {
                <tr>
                    <td>productnavn</td>
                    <td>@product.OEM</td>
                    <td>@product.Price</td>
                    <td>@product.Condition</td>
                    <td>@product.ItemDescription</td>
                    <td>@product.ItemAvailable</td>

                    <!-- Add to Cart Button -->
                    <td>
                        <form action="@Url.Action("AddToCart", "ShoppingCart")" method="post">
                            <input type="hidden" name="productID" value="@product.ID" />
                            <button type="submit">Add to Cart</button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6">No products found.</td> <!-- Adjusted colspan to 6 -->
            </tr>
        }
    </tbody>
</table>
