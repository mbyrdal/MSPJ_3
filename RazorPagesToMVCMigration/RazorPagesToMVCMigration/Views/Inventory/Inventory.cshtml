@model List<RazorPagesToMVCMigration.Models.Car>
{
    ViewData["Title"] = "Lager";
}

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/styles.css" />
</head>
<body>
    <header>
        <img src="~/resources/images/Remove background project.png" alt="Huggerriget Logo" class="logo"> <!-- LOGO location -->
        <h1>HUGGERRIGET</h1>
        <p>I HYGGER, Julia HUGGER</p>
        <div class="top-links">
            <a href="#">DNK / DK / DKK</a>
            <a href="#">Log ind</a>
        </div>
    </header>

    <main class="container">
    
        <!-- Sidebar Section -->
         <aside class="sidebar">
            <h2>Hvad kigger du efter?</h2>
            <ul>
                <li><a href="#">Kategori 1</a></li>
                <li><a href="#">Kategori 2</a></li>
                <li><a href="#">Kategori 3</a></li>
                <li><a href="#">Kategori 4</a></li>
                <li><a href="#">Kategori 5</a></li>
                <li><a href="#">Kategori 6</a></li>
                <li><a href="#">Kategorier af Parts for Mads cybernetics implant</a></li>

            </ul>
        </aside>
          
    

     

        <!-- Main Search Section -->
        <section class="search-section">
            <h2>Søg reservedele</h2>
            <form id="search-part">
                <input type="text" name="partName" placeholder="Reservedel" id="partNameSearch" />
                <button type="submit">Søg</button>
            </form>
            <img id="flying-image" src="~/resources/images/troll/9abmg7.jpg" alt="Flying Image" style="display: none;">
        </section>
        
        <section class="search-result">
            <h3>Lager</h3>
            <table>
                <thead>
                    <tr>
                        <th>VINNumber</th>
                        <th>Brand</th>
                        <th>Model</th>
                        <th>Production Year</th>
                        <th>Mileage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var car in Model)
                    {
                        <tr>
                            <td>@car.VINNumber</td>
                            <td>@car.Brand</td>
                            <td>@car.Model</td>
                            <td>@car.ProductionYear</td>
                            <td>@car.Mileage</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>        
    </main>
    <script src="~/js/script.js"></script>
</body>
</html>
