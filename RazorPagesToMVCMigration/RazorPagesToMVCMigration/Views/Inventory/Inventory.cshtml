@model List<RazorPagesToMVCMigration.Models.Product>

@{
    ViewData["Title"] = "Inventory";
}

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/styles.css" />
</head>
<body>
    <header>
        <img src="~/resources/images/Remove background project.png" alt="Huggerriget Logo" class="logo">
        <h1>HUGGERRIGET</h1>
        <p>I HYGGER, Julia HUGGER</p>
        <div class="top-links">
            <a href="#">DNK / DK / DKK</a>
            <a href="#">Log ind</a>
        </div>
    </header>

    <main class="container">

        <!-- Main Search Section -->
        <section class="search-section">
            <h2>Søg reservedele</h2>
            <form method="get" action="@Url.Action("Inventory", "Home")">
                <input type="text" name="oemNumber" placeholder="OEM Nummer" id="oemSearch" value="@Context.Request.Query["oemNumber"]" />
                <button type="submit">Søg</button>
            </form>
        </section>

        <!-- Lager List Section -->
        <section class="search-result">
            <h3>Lager</h3>
            <table>
                <thead>
                    <tr>
                        <th>OEM</th>
                        <th>VINNummer</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>DateAvailable</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.OEM</td>
                                <td>@product.VINNumber</td>
                                <td>@product.Name</td>
                                <td>@product.Price</td>
                                <td>@product.DateAvailable</td>
                                <td>@product.Notes</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">No products found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

    </main>

    <script src="~/js/script.js"></script>
</body>
</html>
