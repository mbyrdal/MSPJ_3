<Page x:Class="WPFHuggerRiget.AdminDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFHuggerRiget"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminDashboard">

    <Grid Background="#F9F9F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#333" Grid.Row="0">
            <TextBlock Text="Admin Dashboard - Huggerriget" Foreground="White" 
                       FontSize="20" VerticalAlignment="Center" Padding="10"/>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Key Metrics Cards -->
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <Border Background="#4CAF50" Padding="10" CornerRadius="5">
                    <Grid>
                        <TextBlock Text="Total Vehicles Processed" Foreground="White" FontSize="18"/>
                        <TextBlock Text="1,245" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0" FlowDirection="RightToLeft"/>
                    </Grid>
                </Border>
                <Border Background="#2196F3" Padding="10" CornerRadius="5">
                    <Grid>
                        <TextBlock Text="Total Parts Sold" Foreground="White" FontSize="18"/>
                        <TextBlock Text="3,678" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0" Width="502" FlowDirection="RightToLeft"/>
                    </Grid>
                </Border>
                <Border Background="#FF9800" Padding="10" CornerRadius="5">
                    <Grid>
                        <TextBlock Text="B2B Customers" Foreground="White" FontSize="18"/>
                        <TextBlock Text="257" Foreground="White" FontSize="24" Margin="0,2,0,3" TextAlignment="Right"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Recent Orders List -->
            <Border Grid.Column="1" Background="White" CornerRadius="5" Padding="10">
                <Grid>
                    <TextBlock Text="Recent Orders" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListView>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Order ID" Width="100" DisplayMemberBinding="{Binding OrderID}"/>
                                <GridViewColumn Header="Customer" Width="200" DisplayMemberBinding="{Binding CustomerName}"/>
                                <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding Status}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
